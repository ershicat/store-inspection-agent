{
  "name": "gaia-inspection-oversight-ui",
  "version": "0.1.0",
  "description": "门店督导 — 督导端界面包：巡店判断回放看板（右侧栏常驻 tab：检查项/判断/证据缩略/整改要求与截止/状态，逾期与催办·升级同屏）、证据挂图卡片（浮层：原图 + 圈框 + 依据文字，无坐标降级纯文字）、立即扫描按钮（真动作，回执来自后端）、模型调用日志面板（右侧栏独立 tab）。纯浏览器 client 半。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./manifest.json": "./manifest.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "manifest.json",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "gaia",
    "inspection",
    "oversight",
    "巡店判断回放看板",
    "证据挂图卡片",
    "立即扫描按钮",
    "模型调用日志面板"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-web-server": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
